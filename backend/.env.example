# Local PostgreSQL only. Render requires both connection URLs from Neon.
DATABASE_URL="postgresql://dss:local_demo_password@localhost:5433/vinmec_dss?schema=public"
DIRECT_URL="postgresql://dss:local_demo_password@localhost:5433/vinmec_dss?schema=public"
JWT_SECRET="change-this-to-a-random-32-character-minimum-secret"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# Leave empty to disable paid AI requests
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_CALLS=20
# Optional for local staff accounts; on Render configure a private, unique password
DEMO_PASSWORD=